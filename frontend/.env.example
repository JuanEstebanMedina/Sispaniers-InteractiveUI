# ============================================================================
# Copiar a `.env` y ajustar.  Sólo las VITE_* llegan al navegador → son
# PÚBLICAS. Nunca poner secretos acá.
# ============================================================================

# --- Backend -----------------------------------------------------------------
# Absoluta (http://localhost:8000/api) o relativa (/api) si usás VITE_API_PROXY.
VITE_API_URL=/api
VITE_API_TIMEOUT=15000

# Si lo definís, Vite proxea /api → este destino y desaparece el CORS en dev.
VITE_API_PROXY=http://127.0.0.1:8000

# --- Identidad visual --------------------------------------------------------
# orchestration (violeta+cian) | freight (navy+ámbar) | ledger (zinc+índigo)
# light | dark | system
VITE_THEME=light
VITE_APP_NAME=Sispaniers

# --- Auth --------------------------------------------------------------------
# localStorage (sobrevive al cierre) | sessionStorage | memory (más seguro)
VITE_AUTH_STORAGE=localStorage

# --- Extras ------------------------------------------------------------------
# VITE_WS_URL=ws://localhost:8000/ws
VITE_DEVTOOLS=false
VITE_PORT=5173
FRONTEND_PORT=5173
# VITE_SENTRY_DSN=
