# =============================================================================
# Copiá este archivo a `.env` y ajustá lo que necesites:
#
#     cp .env.example .env
#
# TODAS estas variables llegan al navegador. Vite sólo expone las que empiezan
# con VITE_, y las expone en el bundle: son PÚBLICAS. Nunca pongas acá una
# clave de API, un secreto ni una credencial. Si el reto pide firmar algo, eso
# vive en el backend.
#
# Todas tienen un valor por defecto razonable en src/config/env.ts, así que la
# app arranca aunque este archivo esté vacío.
# =============================================================================

# --- Backend -----------------------------------------------------------------
# Mientras VITE_USE_MOCKS sea true, un Service Worker responde las peticiones y
# no hace falta backend. El día que exista, poné false y la URL real.
VITE_USE_MOCKS=true
VITE_API_URL=/api

# Timeout por petición, en ms. Corto a propósito: en una demo es mejor fallar
# rápido y mostrar el error que quedarse girando.
VITE_API_TIMEOUT=15000

# Proxy de desarrollo. Si el backend corre local y CORS estorba, apuntá esto al
# backend y dejá VITE_API_URL=/api — el proxy de Vite se encarga.
VITE_API_PROXY=http://127.0.0.1:8000

# Latencia artificial de los mocks, en ms. Sin esto los esqueletos de carga no
# se ven nunca y nadie sabe si están bien hasta que el backend real va lento.
VITE_MOCK_DELAY=320

# --- Apariencia ---------------------------------------------------------------
# light | dark | system. La paleta es una sola (Manifiesto), nació clara.
VITE_THEME=light

# es | pt-BR | en. Vacío = detectar del navegador.
VITE_LOCALE=

VITE_APP_NAME=Sispaniers

# --- Desarrollo ---------------------------------------------------------------
# Precarga las credenciales en el login para no tipear en el escenario.
VITE_DEMO_MODE=true

# Paneles de devtools de React Query y del router.
VITE_DEVTOOLS=true

# localStorage | sessionStorage | memory — ver ADR-004.
VITE_AUTH_STORAGE=localStorage
