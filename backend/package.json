{
  "name": "sispaniers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env dist/main.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "seed": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@google/genai": "^2.19.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "mammoth": "^1.12.2",
    "mongodb": "^7.6.0",
    "nodemailer": "^6.9.16",
    "officeparser": "^7.8.0",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
